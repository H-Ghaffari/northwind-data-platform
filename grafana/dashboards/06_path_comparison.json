{
  "uid": "nw-path-comparison",
  "title": "Northwind — Batch vs Stream",
  "description": "The two ingestion paths side by side. They agree immediately after the snapshot; from there they are fed by different pipelines on different schedules, so a later difference means one has seen changes the other has not — it is not by itself a fault. Entities are matched on the alternate key, never the surrogate key: a surrogate key is invented at load time and the same customer can legitimately be 42 in one warehouse and 91 in the other.",
  "tags": ["northwind", "comparison", "streaming", "batch"],
  "timezone": "browser",
  "style": "dark",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Totals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Revenue — batch",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "northwind-dw" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "#5794F2" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT round(sum(line_total), 2) AS \"Batch\" FROM v_FactOrders_Current"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Revenue — stream",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "northwind-rt" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "#73BF69" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT round(sum(line_total), 2) AS \"Stream\" FROM v_FactOrders_Current"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Orders — batch",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "northwind-dw" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "#5794F2" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT uniqExact(order_id) AS \"Batch\" FROM v_FactOrders_Current"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Orders — stream",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "northwind-rt" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "#73BF69" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT uniqExact(order_id) AS \"Stream\" FROM v_FactOrders_Current"
        }
      ]
    },

    {
      "id": 101,
      "type": "row",
      "title": "Per dimension",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "table",
      "title": "Row counts and overlap",
      "description": "in_both counts entities present on both sides, matched on the alternate key. FactOrders reports 0 there because a fact has no alternate key — its row counts are the comparison.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "northwind-rt" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "delta" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#F2495C", "value": null },
                    { "color": "#73BF69", "value": 0 },
                    { "color": "#F2495C", "value": 1 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT dimension, batch_rows, stream_rows, toInt64(stream_rows) - toInt64(batch_rows) AS delta, in_both FROM v_PathComparison"
        }
      ]
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Side by side",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "northwind-rt" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 85, "lineWidth": 0 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "batch_rows" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }]
          },
          {
            "matcher": { "id": "byName", "options": "stream_rows" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT dimension, batch_rows, stream_rows FROM v_PathComparison WHERE dimension != 'FactOrders'"
        }
      ]
    },

    {
      "id": 102,
      "type": "row",
      "title": "Where they differ",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "id": 20,
      "type": "table",
      "title": "Customer drift",
      "description": "Attribute-level differences, not just counts. An empty table is the healthy state. A row here names which customer and which field, which is what anyone investigating actually needs — and usually means one path has processed a change the other has not yet seen.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "northwind-rt" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text" } }]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT * FROM v_CustomerDrift LIMIT 50"
        }
      ]
    }
  ]
}