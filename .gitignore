cat > .gitignore << 'EOF'
# Secrets — never commit real credentials
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Airflow runtime artefacts
airflow/logs/
airflow.db
airflow.cfg
webserver_config.py

# Large binaries
*.bak
*.rar

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
# Data lake — generated artefacts.
# The avatars are produced deterministically by spark/jobs/lake, so the code
# is the source of truth and the files are its output.
data/lake/employees/*
!data/lake/employees/.gitkeep
