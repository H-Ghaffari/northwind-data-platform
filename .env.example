# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed.
# `.env` itself is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- OP layer: SQL Server --------------------------------------------------
# Must satisfy SQL Server's policy: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=Northwind@2026
OP_DB=Northwind
OP_EXTERNAL_PORT=21433

# --- Staging layer: PostgreSQL --------------------------------------------
STAGING_USER=staging_admin
STAGING_PASSWORD=staging123
STAGING_DB=Staging_Northwind
STAGING_EXTERNAL_PORT=25432

# --- DW layer: ClickHouse --------------------------------------------------
CLICKHOUSE_USER=dw_admin
CLICKHOUSE_PASSWORD=dw123456
DW_DB=NorthwindDW
DW_HTTP_EXTERNAL_PORT=28123
DW_NATIVE_EXTERNAL_PORT=29000

# --- Airflow metadata database --------------------------------------------
AIRFLOW_META_USER=airflow
AIRFLOW_META_PASSWORD=airflow123
AIRFLOW_META_DB=airflow_meta

# --- Airflow runtime -------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_EXTERNAL_PORT=28080
AIRFLOW_TIMEZONE=Asia/Tehran
# On Linux/WSL set this to the output of `id -u`. Leave as 50000 on Windows.
AIRFLOW_UID=50000

# --- Presentation ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_EXTERNAL_PORT=23000
