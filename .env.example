# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed.
# `.env` itself is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- OP layer: SQL Server --------------------------------------------------
# Must satisfy SQL Server's policy: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=Northwind@2026
OP_DB=Northwind
OP_EXTERNAL_PORT=21433

# --- Staging layer: PostgreSQL (batch path only) ---------------------------
STAGING_USER=staging_admin
STAGING_PASSWORD=staging123
STAGING_DB=Staging_Northwind
STAGING_EXTERNAL_PORT=25432

# --- DW layer: ClickHouse --------------------------------------------------
CLICKHOUSE_USER=dw_admin
CLICKHOUSE_PASSWORD=dw123456
DW_DB=NorthwindDW
DW_HTTP_EXTERNAL_PORT=28123
DW_NATIVE_EXTERNAL_PORT=29000

# Streaming path writes to its own database on the same ClickHouse server,
# so the batch warehouse stays verifiable and the two can be compared.
DW_RT_DB=NorthwindRT

# --- Airflow metadata database (batch path only) ---------------------------
AIRFLOW_META_USER=airflow
AIRFLOW_META_PASSWORD=airflow123
AIRFLOW_META_DB=airflow_meta

# --- Airflow runtime (batch path only) -------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_EXTERNAL_PORT=28080
AIRFLOW_TIMEZONE=Asia/Tehran
# On Linux/WSL set this to the output of `id -u`. Leave as 50000 on Windows.
AIRFLOW_UID=50000

# --- Streaming path: Kafka -------------------------------------------------
# Fixed cluster id so KRaft formats storage once and never complains again.
KAFKA_CLUSTER_ID=NorthwindKafkaClusterId
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_EXTERNAL_PORT=28081
# Every topic this project creates is prefixed with this.
KAFKA_TOPIC_PREFIX=nw.cdc
STREAM_POLL_SECONDS=2
STREAM_MAX_ROWS=5000

# --- Streaming path: MongoDB (audit log) -----------------------------------
MONGO_USER=audit_admin
MONGO_PASSWORD=audit123
MONGO_DB=northwind_audit
MONGO_EXTERNAL_PORT=22017

# --- Presentation ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_EXTERNAL_PORT=23000

# --- Streaming path: Elastic stack (audit search and monitoring) ----------
ES_EXTERNAL_PORT=29200
KIBANA_EXTERNAL_PORT=25601